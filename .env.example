# ============================================================
# AI Resume Tailor - environment configuration
# Copy this file to .env and fill in the values you need.
# NEVER commit .env or uploaded resume files.
# ============================================================

# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins (CORS + origin check).
# Include the Vite dev server and the single-server origin if you use both.
# On Render, RENDER_EXTERNAL_URL is used automatically when this is unset;
# set it explicitly when you attach a custom domain.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4000
# Required in production. Use a long random string (>= 32 chars).
JWT_SECRET=change-me-to-a-long-random-development-secret
JWT_EXPIRES_IN=7d
# Cookies are marked Secure when true. Set true in production behind HTTPS.
COOKIE_SECURE=false
# Trust the first proxy hop (needed for rate limiting / secure cookies behind a reverse proxy).
TRUST_PROXY=false

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/ai_resume_tailor

# ---- AI provider ----
# heuristic = deterministic local analyzer (no external calls, no API key).
# openai    = any OpenAI-compatible /chat/completions endpoint.
# anthropic = Anthropic Messages API.
AI_PROVIDER=heuristic
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Override for OpenAI-compatible gateways, Azure proxies, local models, etc.
AI_BASE_URL=
# Request timeout per attempt, total retries, and output token cap.
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=4000
# Maximum characters of resume/JD content sent to the provider.
AI_MAX_RESUME_CHARS=14000
AI_MAX_JD_CHARS=14000

# ---- Uploads and storage ----
# Maximum DOCX size in megabytes.
MAX_UPLOAD_MB=10
# Private storage directory (outside the frontend build directory).
STORAGE_DIR=./storage
# local | s3 (S3-compatible private object storage)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional path/command for LibreOffice headless rendering.
# Leave empty to auto-detect (soffice / libreoffice). HTML preview remains available.
# Windows example: C:\Program Files\LibreOffice\program\soffice.exe
# Detection is cached per process, so restart the server after changing this.
LIBREOFFICE_PATH=

# ---- Retention and cleanup ----
# Days to keep resumes, sessions, and generated exports. 0 disables expiry.
RETENTION_DAYS=30
# How often the cleanup job runs (minutes). 0 disables the scheduled job.
CLEANUP_INTERVAL_MINUTES=60

# ---- Limits and logging ----
# Per-IP API rate limit (requests per 15 minutes).
RATE_LIMIT_MAX=300
LOG_LEVEL=info
# Set to true to print sanitized AI request metadata (never resume content).
LOG_AI_METADATA=false

# ---- Frontend (Vite) ----
# Leave empty to use same-origin requests (or the Vite dev proxy).
VITE_API_BASE_URL=

# ---- Docker Compose only (the app itself does not read these) ----
APP_PORT=4000
MONGO_ROOT_USERNAME=art
# Required by docker-compose.yml. Use a long, URL-safe password.
MONGO_ROOT_PASSWORD=
# Set true to build an image with LibreOffice for PDF previews.
INSTALL_LIBREOFFICE=false

