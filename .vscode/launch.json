{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server: API (debug)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/src/server.js",
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "presentation": {
        "group": "fullstack",
        "order": 1
      }
    },
    {
      "name": "Client: Vite (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/client/src",
      "preLaunchTask": "client: dev",
      "presentation": {
        "group": "fullstack",
        "order": 2
      }
    },
    {
      "name": "Server: tests (Vitest)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run"],
      "cwd": "${workspaceFolder}/server",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Full stack (server + client)",
      "configurations": ["Server: API (debug)", "Client: Vite (Chrome)"],
      "stopAll": true
    }
  ]
}
